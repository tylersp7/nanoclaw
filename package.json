{
  "name": "nanoclaw",
  "version": "1.2.17",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "auth": "tsx src/whatsapp-auth.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@hubspot/api-client": "^13.4.0",
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.14.0",
    "@types/ssh2": "^1.15.5",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "axios": "^1.16.0",
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.5.0",
    "googleapis": "^105.0.0",
    "grammy": "^1.40.1",
    "open": "^11.0.0",
    "openai": "^6.25.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.58.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "rss-parser": "^3.13.0",
    "snoowrap": "^1.23.0",
    "ssh2": "^1.17.0",
    "yaml": "^2.8.2",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/qrcode-terminal": "^0.12.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
